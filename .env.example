# VITE_APPS_SCRIPT_URL: URL Web App của Google Apps Script (Deploy > New deployment > Web app > Anyone)
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID (dùng cho đăng nhập Google nếu kích hoạt)
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
